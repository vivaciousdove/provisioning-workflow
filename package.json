{
  "name": "provisioning-workflow",
  "private": true,
  "devDependencies": {
    "@playwright/test": "^1.57.0",
    "allure-commandline": "^2.36.0",
    "allure-playwright": "^3.4.4"
  },
  "scripts": {
    "api": "python -m uvicorn api:app --host 127.0.0.1 --port 8000",
    "web": "python -m http.server 5173 --directory web",
    "test": "npx playwright test",
    "report:pw": "npx playwright show-report",
    "report:allure": "allure generate ./allure-results -o ./allure-report --clean && allure open ./allure-report",
    "clean:artifacts": "powershell -Command \"Remove-Item -Recurse -Force test-results,playwright-report,allure-report,allure-results -ErrorAction SilentlyContinue\""
  }
}
