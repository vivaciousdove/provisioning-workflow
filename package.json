{
  "name": "provisioning-workflow",
  "private": true,
  "devDependencies": {
    "@playwright/test": "^1.50.0",
    "allure-commandline": "^2.36.0",
    "allure-playwright": "^3.0.0-beta.21"
  },
  "scripts": {
    "test": "playwright test",
    "test:ui": "playwright test --project=ui",
    "test:api": "playwright test --project=api",
